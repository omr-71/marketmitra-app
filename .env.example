# Public Supabase project settings
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only admin credential. Never add VITE_ or NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Groq keys; never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_SPRAY_API_KEY=

# Server-side AGMARKNET API key from data.gov.in. Never use a VITE_ prefix.
AGMARKNET_API_KEY=

# Vercel Cron authorization secret. Configure as CRON_SECRET in Vercel.
CRON_SECRET=
NOTIFICATION_CRON_TEST_USER_ID=
