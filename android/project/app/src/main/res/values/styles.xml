<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MarketMitra" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/market_mitra_status</item>
        <item name="android:navigationBarColor">@color/market_mitra_navigation</item>
        <item name="android:navigationBarDividerColor">@color/market_mitra_navigation</item>
    </style>
    <style name="Theme.MarketMitra.Splash" parent="Theme.MarketMitra">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
